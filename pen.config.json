<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>micro:bit Sentry Turret Tracker</title>
  <!-- Load MediaPipe dependencies -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
</head>
<body style="text-align: center; font-family: sans-serif; background: #121212; color: #fff; padding: 20px;">

  <h2>Sentry Turret Controller</h2>
  <button id="connectBtn" style="padding: 14px 28px; font-size: 18px; font-weight: bold; background: #007bff; color: white; border: none; border-radius: 8px; cursor: pointer;">
    Connect micro:bit
  </button>
  <p id="status" style="font-size: 16px; color: #ffca28;">Status: Disconnected</p>

  <div style="position: relative; display: inline-block; margin-top: 10px;">
    <video id="webcam" style="width: 320px; height: 240px; transform: scaleX(-1); border-radius: 12px;" autoplay playsinline></video>
  </div>

  <script>
    let uartCharacteristic = null;
    const UART_SERVICE_UUID = '6e400001-b5a3-f393-e0a9-e50e24dcca9e';
    const UART_TX_UUID = '6e400002-b5a3-f393-e0a9-e50e24dcca9e';

    // 1. Bluetooth Connection Handler
    document.getElementById('connectBtn').addEventListener('click', async () => {
      try {
        const device = await navigator.bluetooth.requestDevice({
          filters: [{ namePrefix: 'BBC micro:bit' }],
          optionalServices: [UART_SERVICE_UUID]
        });
        document.getElementById('status').innerText = "Status: Connecting...";
        const server = await device.gatt.connect();
        const service = await server.getPrimaryService(UART_SERVICE_UUID);
        uartCharacteristic = await service.getCharacteristic(UART_TX_UUID);
        document.getElementById('status').innerText = "Status: Connected & Tracking!";
        document.getElementById('status').style.color = "#4caf50";
      } catch (err) {
        alert("Bluetooth Error: " + err);
        document.getElementById('status').innerText = "Status: Connection Failed";
      }
    });

    // 2. Configure MediaPipe Face Mesh
    const videoElement = document.getElementById('webcam');
    const faceMesh = new FaceMesh({
      locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${file}`
    });

    faceMesh.setOptions({
      maxNumFaces: 1,
      refineLandmarks: false, // Set to false to reduce CPU load on mobile
      minDetectionConfidence: 0.5,
      minTrackingConfidence: 0.5
    });

    // Send coordinates whenever MediaPipe updates
    let lastSentTime = 0;
    faceMesh.onResults((results) => {
      const now = Date.now();
      // Rate-limit transmission to ~20 updates/sec to prevent Bluetooth buffer overload
      if (now - lastSentTime < 50) return;

      if (results.multiFaceLandmarks && results.multiFaceLandmarks.length > 0) {
        const landmarks = results.multiFaceLandmarks[0];
        
        // Landmark index 1 is the nose tip (center of the face)
        // Convert normalized X (0.0 to 1.0) to 0 - 320 pixels
        // (Mirrored: 1 - x so moving right physically turns turret right)
        const faceX = Math.round((1 - landmarks[1].x) * 320);

        if (uartCharacteristic) {
          const encoder = new TextEncoder();
          uartCharacteristic.writeValue(encoder.encode(faceX + "\n"));
          lastSentTime = now;
        }
      }
    });

    // 3. Start Phone Camera Stream
    const camera = new Camera(videoElement, {
      onFrame: async () => {
        await faceMesh.send({ image: videoElement });
      },
      width: 320,
      height: 240
    });
    camera.start();
  </script>
</body>
</html>